enum KanbanColumn {
  TODO
  AI
  REVIEW
  DONE
}

model Project {
  id        String   @id
  name      String
  worktree  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KanbanCard {
  id              String       @id @default(uuid())
  projectId       String
  sessionId       String?
  title           String
  description     String
  column          KanbanColumn @default(TODO)
  position        Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  newBranch       String
  baseBranch      String
  useTravailleMcp Boolean      @default(true)

  @@index([projectId, column, position])
}
