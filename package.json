{
  "name": "travaille",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run turbo dev",
    "dev:back": "bun run turbo dev --filter=back",
    "dev:front": "bun run turbo dev --filter=front",
